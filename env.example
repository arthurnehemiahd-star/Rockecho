# Song generation: pick ONE of the two options below.
#
# Option A — Replicate (paid, pay-per-use, easiest to set up, no local
# hardware needed). Get a token at replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=
REPLICATE_MUSIC_MODEL=lucataco/ace-step
REPLICATE_VIDEO_MODEL=minimax/video-01
#
# Option B — completely free, self-hosted, no account or card at all.
# Leave REPLICATE_API_TOKEN blank above, and instead run the open-source
# ACE-Step-1.5 server yourself (needs a decent GPU for reasonable speed —
# see README for setup). Point this at wherever that server is running:
LOCAL_MUSIC_API_URL=http://localhost:8001

# Anime Video Studio: same pattern as song generation, pick ONE.
# Option A — Replicate (paid). Reuses REPLICATE_API_TOKEN/REPLICATE_VIDEO_MODEL above.
# Option B — free, self-hosted ComfyUI running Wan 2.2 (needs a real GPU —
# see README for setup, including preparing the workflow file below).
LOCAL_VIDEO_API_URL=http://localhost:8188
LOCAL_VIDEO_WORKFLOW_PATH=./workflows/video-workflow.json

# Optional: enables AI-written lyrics in Simple mode. Without this, a basic
# built-in lyric template is used instead (also free).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: powers Stem Separation and Extend via fal.ai (paid, pay-per-use).
# Leave blank to use the free local fallback instead (needs demucs + ffmpeg
# installed on this machine — see README).
FAL_KEY=
FAL_STEMS_MODEL=fal-ai/demucs
FAL_EXTEND_MODEL=fal-ai/ace-step/audio-outpaint

# Required for real "forgot password" emails to send. Uses a free Gmail
# account and an App Password (not your normal Gmail password) — see README.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# The public URL this app is deployed at, used to build the link inside
# password-reset emails. Defaults to whatever host the request came in on.
APP_BASE_URL=
PORT=3000
